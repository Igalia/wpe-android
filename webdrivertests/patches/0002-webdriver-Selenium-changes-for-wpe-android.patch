+
 class RemoteConnection:
     """A connection with the Remote WebDriver server.
 
@@ -278,8 +281,16 @@ class RemoteConnection:
         auth = f"{parsed_url.username}:{parsed_url.password}"
         return proxy_without_auth, auth
 
+    def _bounded_timeout(self):
+        timeout = self._client_config.timeout
+        if timeout is None:
+            return None
+        # A driver that does not accept connections should fail fast; commands get their full time.
+        return urllib3.Timeout(connect=min(CONNECT_TIMEOUT_SECONDS, timeout), read=timeout)
+
     def _get_connection_manager(self):
-        pool_manager_init_args = {"timeout": self._client_config.timeout}
+        # Never resend a command that may have reached the driver.
+        pool_manager_init_args = {"timeout": self._bounded_timeout(), "retries": urllib3.Retry(total=1, connect=False, read=False)}
         pool_manager_init_args.update(
             self._client_config.init_args_for_pool_manager.get("init_args_for_pool_manager", {})
         )
@@ -427,12 +438,12 @@ class RemoteConnection:
             body = None
 
         if self._client_config.keep_alive:
-            response = self._conn.request(method, url, body=body, headers=headers, timeout=self._client_config.timeout)
+            response = self._conn.request(method, url, body=body, headers=headers, timeout=self._bounded_timeout())
             statuscode = response.status
         else:
             conn = self._get_connection_manager()
             with conn as http:
-                response = http.request(method, url, body=body, headers=headers, timeout=self._client_config.timeout)
+                response = http.request(method, url, body=body, headers=headers, timeout=self._bounded_timeout())
             statuscode = response.status
         data = response.data.decode("UTF-8")
         LOGGER.debug("Remote response: status=%s | data=%s | headers=%s", response.status, data, response.headers)
