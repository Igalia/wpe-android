#!/usr/bin/env python3
"""Runs WebKit's WebDriver tests against the WebDriver app on the device.

The tests and their runner come from WebKit (see fetch-webdriver-tests); the expectations and the script that
starts the WebDriver on the device are wpe-android's. Other arguments go to WebKit's run-webdriver-tests.
"""

import os
import subprocess
import sys
import time

SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
ROOT_DIR = os.path.dirname(os.path.dirname(SCRIPTS_DIR))

fetch = subprocess.run([sys.executable, os.path.join(SCRIPTS_DIR, "fetch-webdriver-tests")],
                       stdout=subprocess.PIPE, text=True)
if fetch.returncode != 0:
    sys.exit(fetch.returncode)
webkit_dir = fetch.stdout.strip()
runner = os.path.join(webkit_dir, "Tools", "Scripts", "run-webdriver-tests")

# Start from a clean device.
subprocess.run("adb shell am force-stop org.wpewebkit.tools.webdriver", shell=True)
subprocess.run("adb forward --remove-all", shell=True)
subprocess.run("adb reverse --remove-all", capture_output=True, shell=True)
time.sleep(1)

# The packages come from this Python environment (webdrivertests/requirements.txt).
os.environ["DISABLE_WEBKITCOREPY_AUTOINSTALLER"] = "1"
os.execv(sys.executable, [sys.executable, runner,
                          "--expectations=%s" % os.path.join(ROOT_DIR, "webdrivertests", "TestExpectations.json"),
                          "--driver-binary=%s" % os.path.join(SCRIPTS_DIR, "wpeviewdriver"),
                          *sys.argv[1:]])
